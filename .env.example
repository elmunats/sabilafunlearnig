APP_NAME="Sabila Fun Learning"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://sabilafunlearning.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database Configuration (MySQL / MariaDB on DirectAdmin Host)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sabila_fun_learning
DB_USERNAME=sabila_user
DB_PASSWORD=strong_secret_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Private Media Storage Driver ('local' private storage or 's3' for Cloudflare R2 / AWS S3)
MEDIA_DISK=s3

# S3 / Cloudflare R2 Private Bucket Configuration
AWS_ACCESS_KEY_ID=your_r2_or_s3_access_key
AWS_SECRET_ACCESS_KEY=your_r2_or_s3_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=sabila-private-media
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
